{
  "info": {
    "name": "Accountant Hub",
    "description": "Full API collection for Accountant Hub. Set `base_url` to your backend URL before use. `token` is set automatically after a successful login or register.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Token saved:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Accountant\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Token saved:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@accountant-hub.test\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Me (Current User)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": ["{{base_url}}"],
              "path": ["me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/categories",
              "host": ["{{base_url}}"],
              "path": ["categories"]
            }
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "search", "value": "", "disabled": true, "description": "Filter by job title" },
                { "key": "category", "value": "", "disabled": true, "description": "Comma-separated category slugs e.g. tax-preparation,audit" },
                { "key": "budget_min", "value": "", "disabled": true, "description": "Minimum budget" },
                { "key": "budget_max", "value": "", "disabled": true, "description": "Maximum budget" },
                { "key": "sort", "value": "newest", "disabled": true, "description": "newest or highest_budget" },
                { "key": "page", "value": "1", "disabled": true },
                { "key": "per_page", "value": "12", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "List Jobs — Search",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs?search=tax",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "search", "value": "tax" }
              ]
            }
          }
        },
        {
          "name": "List Jobs — Filter by Category",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs?category=tax-preparation,audit",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "category", "value": "tax-preparation,audit" }
              ]
            }
          }
        },
        {
          "name": "List Jobs — Filter by Budget",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs?budget_min=500&budget_max=2000",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "budget_min", "value": "500" },
                { "key": "budget_max", "value": "2000" }
              ]
            }
          }
        },
        {
          "name": "List Jobs — Sort by Highest Budget",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs?sort=highest_budget",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "sort", "value": "highest_budget" }
              ]
            }
          }
        },
        {
          "name": "Get Job Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "description": "Optional — include to get user_has_bid field" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs/1",
              "host": ["{{base_url}}"],
              "path": ["jobs", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Bids",
      "item": [
        {
          "name": "Submit Bid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposed_price\": 750,\n  \"estimated_delivery_time\": \"2 weeks\",\n  \"cover_letter\": \"I have extensive experience in this area and would be delighted to bring my expertise to your project. I have handled similar engagements for clients in your industry and understand the nuances involved.\",\n  \"experience_summary\": \"CPA certified with 6 years of public accounting experience. Specialized in tax compliance and financial reporting for SMEs.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/jobs/1/bids",
              "host": ["{{base_url}}"],
              "path": ["jobs", "1", "bids"]
            }
          }
        },
        {
          "name": "My Bids",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/my-bids",
              "host": ["{{base_url}}"],
              "path": ["my-bids"],
              "query": [
                { "key": "page", "value": "1", "disabled": true },
                { "key": "per_page", "value": "12", "disabled": true }
              ]
            }
          }
        }
      ]
    }
  ]
}
