{
  "info": {
    "name": "Accountant Hub",
    "description": "Full API collection for Accountant Hub. Set `base_url` to your backend URL before use. `token` is set automatically after a successful login or register.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Accountant)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Token saved:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Accountant\",\n  \"email\": \"accountant@example.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\",\n  \"role\": \"accountant\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "Register (Client)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Token saved:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Client\",\n  \"email\": \"client@example.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\",\n  \"role\": \"client\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": ["{{base_url}}"],
              "path": ["register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Token saved:', res.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@accountant-hub.test\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Me (Current User)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/me",
              "host": ["{{base_url}}"],
              "path": ["me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/categories",
              "host": ["{{base_url}}"],
              "path": ["categories"]
            }
          }
        }
      ]
    },
    {
      "name": "Jobs (Public)",
      "item": [
        {
          "name": "List Jobs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "search", "value": "", "disabled": true, "description": "Filter by job title" },
                { "key": "category", "value": "", "disabled": true, "description": "Comma-separated category slugs e.g. tax-preparation,audit" },
                { "key": "budget_min", "value": "", "disabled": true, "description": "Minimum budget" },
                { "key": "budget_max", "value": "", "disabled": true, "description": "Maximum budget" },
                { "key": "sort", "value": "newest", "disabled": true, "description": "newest or highest_budget" },
                { "key": "date_from", "value": "", "disabled": true, "description": "Filter from month, format: YYYY-MM" },
                { "key": "date_to", "value": "", "disabled": true, "description": "Filter to month, format: YYYY-MM" },
                { "key": "page", "value": "1", "disabled": true },
                { "key": "per_page", "value": "12", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "List Jobs — Search",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs?search=tax",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "search", "value": "tax" }
              ]
            }
          }
        },
        {
          "name": "List Jobs — Filter by Category",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs?category=tax-preparation,audit",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "category", "value": "tax-preparation,audit" }
              ]
            }
          }
        },
        {
          "name": "List Jobs — Filter by Budget",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs?budget_min=500&budget_max=2000",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "budget_min", "value": "500" },
                { "key": "budget_max", "value": "2000" }
              ]
            }
          }
        },
        {
          "name": "List Jobs — Filter by Date Range",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs?date_from=2026-01&date_to=2026-05",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "date_from", "value": "2026-01" },
                { "key": "date_to", "value": "2026-05" }
              ]
            }
          }
        },
        {
          "name": "List Jobs — Sort by Highest Budget",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs?sort=highest_budget",
              "host": ["{{base_url}}"],
              "path": ["jobs"],
              "query": [
                { "key": "sort", "value": "highest_budget" }
              ]
            }
          }
        },
        {
          "name": "Get Job Years",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs/years",
              "host": ["{{base_url}}"],
              "path": ["jobs", "years"]
            }
          }
        },
        {
          "name": "Get Job Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "description": "Optional — include to get user_has_bid field" }
            ],
            "url": {
              "raw": "{{base_url}}/jobs/1",
              "host": ["{{base_url}}"],
              "path": ["jobs", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Accountant — Bids",
      "description": "Requires authentication as an accountant (role: accountant)",
      "item": [
        {
          "name": "Submit Bid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposed_price\": 750,\n  \"estimated_delivery_time\": \"2 weeks\",\n  \"cover_letter\": \"I have extensive experience in this area and would be delighted to bring my expertise to your project. I have handled similar engagements for clients in your industry and understand the nuances involved.\",\n  \"experience_summary\": \"CPA certified with 6 years of public accounting experience. Specialized in tax compliance and financial reporting for SMEs.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/jobs/1/bids",
              "host": ["{{base_url}}"],
              "path": ["jobs", "1", "bids"]
            }
          }
        },
        {
          "name": "My Bids",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/my-bids",
              "host": ["{{base_url}}"],
              "path": ["my-bids"],
              "query": [
                { "key": "page", "value": "1", "disabled": true },
                { "key": "per_page", "value": "12", "disabled": true }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Client — Jobs",
      "description": "Requires authentication as a client (role: client). All routes are prefixed with /client.",
      "item": [
        {
          "name": "List My Jobs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/client/jobs",
              "host": ["{{base_url}}"],
              "path": ["client", "jobs"],
              "query": [
                { "key": "page", "value": "1", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Post a Job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": 1,\n  \"title\": \"Bookkeeper Needed for Small E-commerce Business\",\n  \"company_name\": \"Acme Corp\",\n  \"short_description\": \"Looking for an experienced bookkeeper to manage monthly accounts and reconciliations.\",\n  \"description\": \"We are a growing e-commerce company seeking a detail-oriented bookkeeper to handle our monthly financial records. Responsibilities include accounts payable/receivable, bank reconciliations, and preparing financial summaries. Must be proficient in QuickBooks and have at least 3 years of experience.\",\n  \"budget_min\": 500,\n  \"budget_max\": 1500,\n  \"deadline\": \"2026-07-01\",\n  \"expected_delivery_time\": \"1 month\",\n  \"required_skills\": [\"QuickBooks\", \"Bookkeeping\", \"Bank Reconciliation\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/client/jobs",
              "host": ["{{base_url}}"],
              "path": ["client", "jobs"]
            }
          }
        },
        {
          "name": "Get My Job Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/client/jobs/1",
              "host": ["{{base_url}}"],
              "path": ["client", "jobs", "1"]
            }
          }
        },
        {
          "name": "Update a Job",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Job Title\",\n  \"budget_max\": 2000\n}"
            },
            "url": {
              "raw": "{{base_url}}/client/jobs/1",
              "host": ["{{base_url}}"],
              "path": ["client", "jobs", "1"]
            }
          }
        },
        {
          "name": "Delete a Job",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/client/jobs/1",
              "host": ["{{base_url}}"],
              "path": ["client", "jobs", "1"]
            }
          }
        },
        {
          "name": "Upload Attachment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "description": "Allowed: pdf, doc, docx, xls, xlsx, png, jpg, jpeg, zip. Max 10 MB."
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/client/jobs/1/attachments",
              "host": ["{{base_url}}"],
              "path": ["client", "jobs", "1", "attachments"]
            },
            "description": "Uploads a file and appends its path to the job's attachments array. Returns the attachment object with path, name, and url. Original filename is preserved."
          }
        },
        {
          "name": "Delete Attachment",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"path\": \"job-attachments/1/invoice.pdf\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/client/jobs/1/attachments",
              "host": ["{{base_url}}"],
              "path": ["client", "jobs", "1", "attachments"]
            },
            "description": "Deletes the file from storage and removes its path from the job's attachments array. Pass the exact `path` value returned by the upload endpoint."
          }
        }
      ]
    },
    {
      "name": "Client — Bid Management",
      "description": "Requires authentication as a client (role: client). Review and accept/reject bids on owned jobs.",
      "item": [
        {
          "name": "List Bids for a Job",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/client/jobs/1/bids",
              "host": ["{{base_url}}"],
              "path": ["client", "jobs", "1", "bids"],
              "query": [
                { "key": "page", "value": "1", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Accept a Bid",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/client/jobs/1/bids/1",
              "host": ["{{base_url}}"],
              "path": ["client", "jobs", "1", "bids", "1"],
              "description": "Accepting a bid automatically closes the job and rejects all other bids."
            }
          }
        },
        {
          "name": "Reject a Bid",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/client/jobs/1/bids/1",
              "host": ["{{base_url}}"],
              "path": ["client", "jobs", "1", "bids", "1"]
            }
          }
        }
      ]
    }
  ]
}
